rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accountAllowsAccess() {
      return !exists(/databases/$(database)/documents/platformAccounts/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/platformAccounts/$(request.auth.uid)).data.status == 'active';
    }
    function isOwner() {
      return signedIn() &&
        get(/databases/$(database)/documents/platformAccounts/$(request.auth.uid)).data.role == 'owner' &&
        get(/databases/$(database)/documents/platformAccounts/$(request.auth.uid)).data.status == 'active';
    }
    function isStaff(gid) {
      return gid is string && signedIn() && accountAllowsAccess() &&
        (isOwner() || exists(/databases/$(database)/documents/groupMembers/$(gid + '_' + request.auth.uid)));
    }
    function isSports(gid) {
      return !exists(/databases/$(database)/documents/groups/$(gid)) ||
        get(/databases/$(database)/documents/groups/$(gid)).data.get('kind', 'sports') != 'shared_bills';
    }

    match /members/{id} {
      allow read: if true;
      allow create: if isStaff(request.resource.data.groupId);
      allow update: if isStaff(resource.data.groupId) && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isStaff(resource.data.groupId) && isSports(resource.data.groupId);
    }
    match /matches/{id} {
      allow read: if true;
      allow create: if isStaff(request.resource.data.groupId) && isSports(request.resource.data.groupId);
      allow update: if isStaff(resource.data.groupId) && isSports(resource.data.groupId) && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isStaff(resource.data.groupId) && isSports(resource.data.groupId);
    }
    match /matches/{id}/{sub}/{doc} {
      function parentGroup() { return get(/databases/$(database)/documents/matches/$(id)).data.groupId; }
      allow read: if true;
      allow create: if isStaff(parentGroup()) && isSports(parentGroup()) &&
        (!(sub in ['shares', 'ratings']) || request.resource.data.groupId == parentGroup());
      allow update, delete: if isStaff(parentGroup()) && isSports(parentGroup());
    }
    match /{path=**}/shares/{id} { allow read: if true; }
    match /{path=**}/ratings/{id} { allow read: if true; }
    match /configs/{id} {
      allow read: if id in ['last_match', 'scoringWeights'] && isStaff('football-zigvy');
      allow write: if id == 'scoringWeights' && isStaff('football-zigvy');
    }
    match /appConfig/{id} {
      allow read, write: if id == 'publicPasscode' && isStaff('football-zigvy');
    }
    match /actionConfigs/{id} { allow read: if true; allow write: if false; }
    match /userRoles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /notificationTokens/{id} { allow read, write: if false; }
    match /notifications/{id} {
      allow read, update: if isStaff(resource.data.groupId);
      allow create, delete: if false;
    }
    match /paymentRequests/{id} { allow read, write: if false; }
    match /paymentQueue/{id} { allow read, write: if false; }
    match /slackQueue/{id} { allow read, write: if false; }
    match /billNotificationJobs/{id} { allow read, write: if false; }
    match /telegramConnections/{id} { allow read, write: if false; }
    match /telegramDestinations/{id} { allow read, write: if false; }
    match /telegramUpdates/{id} { allow read, write: if false; }
    match /notificationState/{id} { allow read, write: if false; }

    // Platform records: server (Admin SDK) only.
    match /platformAccounts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /groupMembers/{id} {
      // get works even when the doc is missing (id ends with "_<uid>").
      allow get: if signedIn() && id.matches('.*_' + request.auth.uid);
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /groupSecrets/{gid} { allow read, write: if false; }
    match /eloLeaderboards/{gid} {
      allow read: if true;
      allow write: if isStaff(gid);
    }
    match /groups/{gid} {
      allow read: if true;
      allow write: if false;
      // Financial data is served through authenticated manager APIs only.
      match /bills/{billId}/{document=**} { allow read, write: if false; }
      match /subscriptions/{subscriptionId} { allow read, write: if false; }
      match /settings/{name} {
        allow read: if name in ['lastMatch', 'slack'] && isStaff(gid);
        allow write: if name == 'lastMatch' && isStaff(gid);
      }
      match /stats/{name} {
        allow read: if true;
        allow write: if isStaff(gid);
      }
    }
  }
}

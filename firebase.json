{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "server",
    "runtime": "nodejs22"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false }
  },
  "hosting": [
    {
      "site": "thienbun-payment",
      "public": "web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/(manifest.json|manifest.webmanifest)",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/(sw.js|firebase-messaging-sw.js|registerSW.js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "api",
          "region": "us-central1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "foolball-payment",
      "public": "web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/(manifest.json|manifest.webmanifest)",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/(sw.js|firebase-messaging-sw.js|registerSW.js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "api",
          "region": "us-central1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
